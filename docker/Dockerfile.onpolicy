# syntax=docker/dockerfile:1
# The post-SFT stage's vLLM image (onpolicy/, scripts/onpolicy.sh, scripts/rl.sh, docs/post-training.md §5, §6): the
# evaluation image (docker/Dockerfile.eval: vLLM 0.32.0, torch, transformers, EvalPlus) with matplotlib for the KodCode
# tests that import it (onpolicy/verify.py), under the image's constraints.
FROM nanochat-eval
ARG MATPLOTLIB=3.11.2
RUN uv pip install -c /opt/base-constraints.txt matplotlib==$MATPLOTLIB && \
    python -c "import importlib.metadata as m, json; import transformers.trainer; \
      d = json.load(open('/opt/tools.json')); \
      d.update({p: m.version(p) for p in ('transformers', 'accelerate', 'pytest', 'matplotlib')}); \
      json.dump(d, open('/opt/tools.json', 'w'), indent=1)"
